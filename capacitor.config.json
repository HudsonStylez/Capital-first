{
  "appId": "com.capitalone.app",
  "appName": "Capital One",
  "appVersion": "1.0.0",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://capitalone.hudson-ofccl.workers.dev",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowAfter": 0,
      "launchAutoHide": true,
      "backgroundColor": "#ffffff"
    },
    "Keyboard": {
      "resize": false,
      "resizeOnKeyboardShow": false,
      "style": "none"
    },
    "StatusBar": {
      "style": "default",
      "backgroundColor": "#005C9D"
    },
    "Device": {
      "iosPaddingContentTop": true
    }
  },
  "ios": {
    "scheme": "capitalone",
    "contentInset": "always",
    "schemePersists": true,
    "contentMode": "standalone"
  },
  "android": {
    "scheme": "capitalone",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false,
    "compileSdkVersion": 35,
    "minSdkVersion": 23,
    "targetSdkVersion": 35,
    "buildToolsVersion": "35.0.0"
  }
}