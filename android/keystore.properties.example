# Copy this file to `android/keystore.properties` and fill in your values.
# NEVER commit the filled-in keystore.properties or the .keystore file — both
# are already gitignored.
#
# Generate a keystore once (keep it forever — you must reuse it for updates):
#   keytool -genkeypair -v -keystore capitalone-release.keystore \
#     -alias capitalone -keyalg RSA -keysize 2048 -validity 10000
#
# Place the .keystore file at android/app/capitalone-release.keystore
# (storeFile is resolved relative to android/app/).

storeFile=capitalone-release.keystore
storePassword=CHANGE_ME
keyAlias=capitalone
keyPassword=CHANGE_ME
