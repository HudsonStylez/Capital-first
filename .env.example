# =============================================================================
# Capital One Clone - Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (Vite) - Available as import.meta.env.VITE_*
# -----------------------------------------------------------------------------

# Backend API base URL for email receipts
# Local: http://localhost:3001
# Production: https://your-backend.onrender.com or https://your-app.vercel.app/api
VITE_API_BASE_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Backend (Express + Nodemailer) - Available as process.env.*
# -----------------------------------------------------------------------------

# Port for local development (default: 3001)
PORT=3001

# Email Service Configuration (choose ONE provider)
# -------------------------------------------------

# Option 1: SendGrid (recommended for production)
# Get API key at: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# Option 2: Mailgun
# Get credentials at: https://app.mailgun.com/app/account/security/api_keys
MAILGUN_API_KEY=
MAILGUN_DOMAIN=  # e.g., mg.yourdomain.com

# If neither is set, backend uses mock transport (logs to console)

# -----------------------------------------------------------------------------
# Optional: AI Features (Gemini)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# App URL (for self-referential links, OAuth callbacks)
# -----------------------------------------------------------------------------
APP_URL=http://localhost:5173